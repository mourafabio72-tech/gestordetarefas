# ── Banco de Dados ───────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=troque_por_uma_senha_forte

# ── Backend ──────────────────────────────────────────────────────
SECRET_KEY=gere_uma_chave_forte_ex_openssl_rand_hex_32
# DATABASE_URL é montada pelo docker-compose a partir de DB_USER/DB_PASSWORD.
# Só defina manualmente se usar um Postgres externo/gerenciado:
# DATABASE_URL=postgresql://usuario:senha@host:5432/gestor_tarefas

# ── Entrada pelo Hub Zoaria (SSO) ────────────────────────────────
# MESMO valor no Hub (zoaria.com.br) e aqui. Vazio desliga a entrada pelo card
# do Hub, e o login por e-mail e senha continua funcionando normalmente.
ZOARIA_SSO_SECRET=

# ── Admin inicial (criado só na 1ª subida, se a tabela estiver vazia) ──
ADMIN_EMAIL=admin@bps4.com.br
ADMIN_PASSWORD=troque_no_primeiro_acesso
ADMIN_NOME=Administrador

# ── Alertas WhatsApp (Zap Contábil) ──────────────────────────────
ZAP_API_URL=https://api-bps4.zapcontabil.chat
ZAP_API_KEY=
ZAP_CONNECTION_FROM=0
ZAP_PHONE=5521971985815
ALERT_DAYS_BEFORE=3

# ── Alertas Teams (opcional) ─────────────────────────────────────
TEAMS_WEBHOOK_URL=
